[user]
  email = foo@bar.baz
  name = First Last

[core]
  pager = delta

[interactive]
  diffFilter = delta --color-only

[include]
  path = ~/.config/themes/catppuccin.gitconfig

[delta]
  side-by-side = true
  line-numbers = true
  navigate = true
  dark = true
  features = catppuccin-mocha

[merge]
  conflictstyle = zdiff3
